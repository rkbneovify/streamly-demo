{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "botman/botman": "^2.6",
        "botman/driver-web": "^1.5",
        "cboden/ratchet": "^0.4.3",
        "doctrine/dbal": "^3.0",
        "garygreen/pretty-routes": "^1.0",
        "gghughunishvili/entrust": "^10.0",
        "guzzlehttp/psr7": "^2.8",
        "hashids/hashids": "^4.1",
        "intervention/image": "^2.7",
        "jenssegers/agent": "^2.6",
        "kreait/laravel-firebase": "^4.0",
        "laravel/cashier": "^12.17",
        "laravel/framework": "^9.0",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "pbmedia/laravel-ffmpeg": "8",
        "piwik/device-detector": "^3.12",
        "realrashid/sweet-alert": "^7.3",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-permission": "^5.0",
        "stevebauman/location": "^6.6",
        "tymon/jwt-auth": "^1.0",
        "yajra/laravel-datatables-oracle": "^9.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fakerphp/faker": "^1.20",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^6.0",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories",
            "config/buydrm/classes"
        ],
        "files": [
            "app/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
