<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:gravity="center"
android:layout_gravity="center"
android:background="@color/qrbackground"
tools:context=".HotelQRCode.HotelQRCodeActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qrbackground"
    tools:context=".QRCode.QRCodeActivity">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="78px"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        android:src="@mipmap/streamly_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/helvetica_neue_medium"
        android:text="@string/qr_login"
      android:textAlignment="center"
        android:textColor="@color/md_white_1000"
        android:textSize="50px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout3"
        android:layout_width="600dp"
        android:layout_height="300dp"
        android:background="@color/color_white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:layout_constraintTop_toTopOf="@+id/textView2">


        <TextView
            android:id="@+id/text_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="34px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/helvetica_neue_medium"
            android:text="@string/need_follow_these_step"
            android:textColor="@color/md_black_1000"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            />
        <TextView
            android:id="@+id/tv_first_step"
            android:layout_width="500px"
            android:layout_height="wrap_content"
            android:layout_marginStart="51px"
            android:layout_marginTop="110px"
            android:fontFamily="@font/helvetica_neue_medium"
            android:text="@string/open_app_your_phone"
            android:textColor="@color/md_black_1000"
            android:textSize="31px"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_hotel_qr_code"/>


        <TextView
            android:id="@+id/tv_second_step"
            android:layout_width="500px"
            android:layout_height="wrap_content"
            android:layout_marginStart="51px"
            android:layout_marginTop="@dimen/_10sdp"

            android:fontFamily="@font/helvetica_neue_medium"
            android:text="@string/tap_navbar_and_select_qr_scanner"
            android:textColor="@color/md_black_1000"
            android:textSize="31px"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_first_step"
            app:layout_constraintStart_toStartOf="parent"
           />

        <TextView
            android:layout_width="500px"
            android:layout_height="wrap_content"
            android:layout_marginStart="51px"
            android:fontFamily="@font/helvetica_neue_medium"
            android:text="@string/point_your_phone_to_this_screen_capture"
            android:textColor="@color/md_black_1000"
            android:textSize="31px"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@+id/tv_second_step"
            app:layout_constraintStart_toStartOf="parent"
         />


        <ImageView
            android:id="@+id/img_hotel_qr_code"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:src="@mipmap/streamly_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.398" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_bottom_text"
        android:layout_width="match_parent"
        android:layout_height="46px"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/helvetica_neue_medium"
        android:text="@string/stay_text1"
        android:textColor="#CCFFFFFF"
        android:layout_marginTop="10dp"
        android:textSize="34px"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

<ProgressBar
    android:id="@+id/progress_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:elevation="@dimen/_6sdp"
    android:minHeight="@dimen/_30sdp"
    android:minWidth="@dimen/_60sdp"
    android:visibility="gone"
    android:indeterminateTint="@color/progress_bar_color" />

</FrameLayout>