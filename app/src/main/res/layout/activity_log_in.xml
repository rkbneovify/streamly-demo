<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/splash_background"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".log_in.LogInActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/streamly_logo"
            android:id="@+id/top_panel_banner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_240sdp"
            android:background="@drawable/edittext_outline"
            android:orientation="vertical"
            android:paddingLeft="@dimen/_20sdp"
            android:paddingTop="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@+id/top_panel_banner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica_neue_bold"
                android:text="@string/sign_in"
                android:textAlignment="center"
                android:textColor="@color/app_blue_light"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/username"
                android:textColor="@color/md_black_1000"
                android:textSize="@dimen/_7ssp" />



            <EditText
                android:id="@+id/ed_user_name"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/edittext_states"
                android:fontFamily="@font/helvetica_neue_regular"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1"
                android:padding="@dimen/_4sdp"
                android:textAlignment="viewStart"
                android:textColor="@color/md_black_1000"
                android:textColorHint="@color/md_grey_600"
                android:textSize="@dimen/_7ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/password"
                android:textColor="@color/md_black_1000"
                android:textSize="@dimen/_7ssp" />

            <LinearLayout
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/edittext_states"
                android:gravity="center">

            <EditText
                android:id="@+id/ed_password"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_20sdp"
                android:fontFamily="@font/helvetica_neue_regular"
                android:inputType="textPassword"
                android:maxLength="40"
                android:maxLines="1"
                android:padding="@dimen/_4sdp"
                android:textAlignment="viewStart"
                android:background="@drawable/edittext_password"
                android:textColor="@color/md_black_1000"
                android:textColorHint="@color/md_grey_600"
                android:textSize="@dimen/_7ssp"/>

                <ImageView
                    android:id="@+id/password_toggle"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:focusableInTouchMode="true"
                    android:focusable="true"
                    android:padding="@dimen/_4sdp"
                    android:background="@drawable/edittext_password_btn"
                    android:src="@drawable/ic_baseline_visibility_off_24"/>

            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/_160sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <CheckBox
                    android:id="@+id/checkbox_remember"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_gravity="left"
                    android:fontFamily="@font/helvetica_neue_medium"
                    android:text="@string/remember"
                    android:textColor="@drawable/text_states"
                    android:textSize="@dimen/_7ssp"
                    android:theme="@style/MyCheckbox" />


                <TextView
                    android:id="@+id/txt_need_help"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:layout_marginLeft="@dimen/_6sdp"
                    android:fontFamily="@font/helvetica_neue_medium"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/need_help"
                    android:textAlignment="center"
                    android:textColor="@drawable/text_states"
                    android:textSize="@dimen/_7ssp"
                    tools:ignore="RtlCompat"
                    android:focusableInTouchMode="true"
                    android:focusable="true"/>

            </FrameLayout>

            <Button
                android:id="@+id/btn_sign_in"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/signin_focused"
                android:fontFamily="@font/helvetica_neue_bold"
                android:padding="@dimen/_2sdp"
                android:text="@string/signIn"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/color_white"
                android:textSize="@dimen/_7ssp" />

            <LinearLayout
                android:layout_width="@dimen/_160sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:visibility="visible"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/btn_login_using_passcode_uses"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:background="@drawable/signin_focused"
                    android:fontFamily="@font/helvetica_neue_bold"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/login_using_passcode"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/color_white"
                    android:textSize="@dimen/_7ssp"
                    android:visibility="visible"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_160sdp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp"
                android:orientation="horizontal"
                android:visibility="visible">


                <Button
                    android:id="@+id/btn_hotel_sign_in"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:background="@drawable/signin_focused"
                    android:fontFamily="@font/helvetica_neue_bold"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/hotelSignIn"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/color_white"
                    android:textSize="@dimen/_7ssp"
                    android:visibility="visible" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_160sdp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp"
                android:orientation="horizontal"
                android:gravity="end">


                <Button
                    android:id="@+id/btn_terms_uses"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:background="@drawable/register_background"
                    android:fontFamily="@font/helvetica_neue_medium"
                    android:text="@string/terms"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@drawable/register_background"
                    android:textSize="@dimen/_6ssp"
                    android:visibility="gone"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_2sdp"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:fontFamily="@font/helvetica_neue_medium"
                    android:text="@string/register_account"
                    android:textColor="@color/md_black_1000"
                    android:textSize="@dimen/_7ssp" />

                <Button
                    android:id="@+id/btn_register_view"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:background="@drawable/register_background"
                    android:fontFamily="@font/helvetica_neue_medium"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/register_now"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@drawable/register_background"
                    android:textSize="@dimen/_6ssp"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/login_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>