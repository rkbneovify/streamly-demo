<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_320sdp"
    android:layout_height="@dimen/_180sdp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/blur_background"
    tools:context=".streamly.settings.support.SupportActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4">

        <ImageView
            android:id="@+id/ivclose"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="right"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/options_states"
            android:focusable="true"
            android:padding="0dp"
            android:visibility="visible"
            android:src="@drawable/close" />

        <ImageView
            android:id="@+id/iv_support_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:src="@drawable/support_img"
            android:visibility="visible" />
    </RelativeLayout>
    <TextView
        android:id="@+id/support_msg"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.09"
        android:visibility="visible"
        android:fontFamily="@font/helvetica_neue_medium"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:textColor="@color/color_white"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/support_lay"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.20"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/support_rectangle_white_box"
            android:gravity="center_horizontal"
            android:focusableInTouchMode="true"
            android:focusedByDefault="true"
            android:nextFocusDown="@id/ivclose"
            android:focusable="true"
            android:orientation="vertical"
            android:elevation="5dp"
            android:padding="@dimen/_2sdp">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/ic_baseline_mail_outline_24" />

            <TextView
                android:id="@+id/support_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:textColor="@color/color_white"
                android:textSize="@dimen/_5sdp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/support_rectangle_white_box"
            android:gravity="center_horizontal"
            android:layout_marginStart="@dimen/_26sdp"
            android:orientation="vertical"
            android:padding="@dimen/_2sdp">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/ic_baseline_call_24" />

            <TextView
                android:id="@+id/support_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:textColor="@color/color_white"
                android:textSize="@dimen/_5sdp" />

            <TextView
                android:id="@+id/support_mobile2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:visibility="gone"
                android:textColor="@color/color_white"
                android:textSize="@dimen/_7ssp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/support_progr"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"/>

</LinearLayout>