<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/blur_background"
    tools:context=".user_room.UserRoomActivity">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:theme="@style/appProgress"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!--                android:visibility="gone"-->

        <!--            android:background="@drawable/white_border"-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:src="@mipmap/streamly_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/hotel_account_select_room"
                android:textAlignment="center"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/md_white_1000"
                app:layout_constraintTop_toBottomOf="@+id/imageView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:padding="10dp"
                android:background="@drawable/options_states"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:fontFamily="@font/helvetica_neue_bold"
                android:textSize="@dimen/_10ssp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="20dp"
                android:focusable="true"
                android:id="@+id/room_logout_btn" />

            <!--        <EditText-->
            <!--            android:id="@+id/ed_search"-->
            <!--            android:layout_width="0dp"-->
            <!--            android:layout_height="match_parent"-->
            <!--            android:layout_weight="2.6"-->
            <!--            android:layout_margin="0dp"-->
            <!--            android:background="@null"-->
            <!--            android:drawableLeft="@drawable/ic_search"-->
            <!--            android:drawablePadding="10dp"-->
            <!--            android:hint=" Search Channels"-->
            <!--            android:inputType="text"-->
            <!--            android:maxLength="30"-->
            <!--            android:maxLines="1"-->
            <!--            android:textColor="@color/md_white_1000"-->
            <!--            android:textColorHint="#FF798588"-->
            <!--            android:textSize="@dimen/_12sdp" />-->
            <!--                android:layout_margin="@dimen/_3sdp"-->

            <!--        <ImageView-->
            <!--            android:id="@+id/img_voice_search"-->
            <!--            android:layout_width="0dp"-->
            <!--            android:layout_height="33dp"-->
            <!--            android:layout_weight="0.4"-->
            <!--            android:src="@drawable/ic_voice_search" />-->

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/search_white_border_2"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:elevation="5dp"
            android:translationZ="3dp"
            android:layout_marginBottom="5dp"
            android:weightSum="3">

            <EditText
                android:id="@+id/ed_search_room"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.6"
                android:background="@null"
                android:drawableLeft="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint=" Search Room"
                android:fontFamily="@font/helvetica_neue_medium"
                android:inputType="text"
                android:maxLength="30"
                android:maxLines="1"
                android:focusable="true"
                android:textColor="@android:color/white"
                android:textColorHint="#B0B4B5"
                android:textSize="@dimen/_10sdp" />
            <!--                android:layout_margin="@dimen/_3sdp"-->

            <ImageView
                android:id="@+id/img_voice_search"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="0.4"
                android:focusable="false"
                android:src="@drawable/mic_icon" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">

            <requestFocus />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_room"
                android:focusable="true"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/view_room"/>

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llNoDataFound"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_data_found"
            android:textAlignment="center"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_internet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet"
            android:textAlignment="center"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_no_room_available"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textView_no_room_available"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_room_available"
            android:textAlignment="center"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>