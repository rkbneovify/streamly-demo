<?xml version="1.0" encoding="utf-8"?>
<layout>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context=".settings.SettingsActivity"
 android:background="@drawable/blur_background">

<!-- TODO: Update blank fragment layout -->
<TextView
    android:id="@+id/textView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_36sdp"
    android:layout_marginTop="@dimen/_24sdp"
    android:text="@string/settings"
    android:textAlignment="center"
    android:textColor="@color/md_white_1000"
    android:textSize="@dimen/_14ssp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />



    <TextView
        android:id="@+id/text_channels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_36sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:padding="@dimen/_2sdp"
        android:text="  Channels"
        android:textAllCaps="true"
        android:textAlignment="center"
        android:drawableLeft="@drawable/ic_channel_icon"
        android:background="@drawable/options_foucs"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.91"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/account"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/layout_focus">


        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_noun_account"
            android:contentDescription="@string/account"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account"
            android:textAlignment="center"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_8ssp"
            android:layout_marginTop="@dimen/_12sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/register_device"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_26sdp"
            android:background="@drawable/layout_focus">


            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_register_devices"
                android:contentDescription="@string/register_device"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_device"
                android:textAlignment="center"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_8ssp"
                android:layout_marginTop="@dimen/_12sdp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/support"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_26sdp"
            android:background="@drawable/layout_focus">


            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_noun_support"
                android:contentDescription="@string/support"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support"
                android:textAlignment="center"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_8ssp"
                android:layout_marginTop="@dimen/_12sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacy"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_26sdp"
            android:background="@drawable/layout_focus">


            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_noun_policies"
                android:contentDescription="@string/privacy"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy"
                android:textAlignment="center"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_8ssp"
                android:layout_marginTop="@dimen/_12sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sign_out"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_26sdp"
            android:background="@drawable/layout_focus">


            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_noun_sign_out"
                android:contentDescription="@string/sign_out"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_out"
                android:textAlignment="center"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_8ssp"
                android:layout_marginTop="@dimen/_12sdp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>