<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/conected_device_state"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/recatangle_shape"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp">
        <ImageView
            android:id="@+id/iv_device_pic"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_20sdp">
        </ImageView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/device_id_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="Device id: "
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />
            <TextView
                android:id="@+id/device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="Device Name "
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/device_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="Samsung smart tv -43 inch"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/personalDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="Personal Name "
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/personal_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="Samsung smart tv -43 inch"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>


        <!--        <LinearLayout-->
