<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:focusable="true"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/conected_device_state"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
<LinearLayout

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/_5sdp"
    android:background="@drawable/recatangle_shape"
    android:gravity="center">

    <ImageView
        android:id="@+id/iv_device_pic"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_20sdp"

        >

    </ImageView>
    <LinearLayout

        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/_10sdp"
        >
        <TextView
            android:id="@+id/device_id_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device id: "
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/helvetica_neue_medium"
            android:layout_marginStart="@dimen/_20sdp"/>
        <TextView
            android:id="@+id/device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/helvetica_neue_medium"
            android:layout_marginStart="@dimen/_20sdp"/>
        <TextView
            android:id="@+id/device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Name "
            android:layout_marginTop="@dimen/_8sdp"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/helvetica_neue_medium"
            android:layout_marginStart="@dimen/_20sdp"/>
        <TextView
            android:id="@+id/device_model_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Samsung smart tv -43 inch"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/helvetica_neue_medium"
            android:layout_marginStart="@dimen/_20sdp"/>

    </LinearLayout>


