<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_330sdp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:paddingLeft="@dimen/_12sdp"
    android:paddingRight="@dimen/_12sdp"
    android:paddingBottom="@dimen/_4sdp"
    android:background="@color/color_white"
   >

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/md_black_1000"
        android:textSize="@dimen/_10ssp"
        android:fontFamily="@font/helvetica_neue_medium"
        android:textAlignment="center"
        android:padding="@dimen/_8sdp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We&apos;re having some trouble with your current subscription. We&apos;ll try again, but in meantime you may want to update your subscription. For more help, please visit streamlytv.com or contact at https://streamlytv.com/helpandsupport."
        android:textColor="@color/md_black_1000"
        android:textSize="@dimen/_9ssp"
        android:fontFamily="@font/helvetica_neue_medium"
        android:textAlignment="center"
        android:padding="@dimen/_8sdp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_14sdp">
<!--        <requestFocus/>-->




        <Button
            android:id="@+id/btn_logout"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_20sdp"
            android:elevation="@dimen/_6sdp"
            android:text="@string/logout"
            android:textStyle="bold"
            android:textColor="@color/md_white_1000"
            android:fontFamily="@font/helvetica_neue_bold"
            android:textSize="@dimen/_8ssp"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:layout_marginLeft="@dimen/_6sdp"
            android:background="@drawable/button_states"/>

    </LinearLayout>

</LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="@dimen/_6sdp"
        android:minHeight="@dimen/_30sdp"
        android:minWidth="@dimen/_60sdp"
        android:visibility="gone"
        android:indeterminateTint="@color/progress_bar_color" />

</FrameLayout>

