<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/splash_background"
    tools:context=".streamly.settings.support.SupportActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/support_circle_shape"
        android:padding="@dimen/_10sdp"
        android:src="@drawable/ic_baseline_support_agent_24"/>

    <TextView
        android:id="@+id/support_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_15sdp"
        android:textColor="@color/color_white"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"/>

    <LinearLayout
        android:id="@+id/support_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/_76sdp"
            android:layout_height="@dimen/_70sdp"
            android:background="@drawable/support_rectangle_white_box"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_2sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:src="@drawable/ic_baseline_mail_outline_24" />

            <TextView
                android:id="@+id/support_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:textColor="@color/app_blue_light"
                android:textSize="@dimen/_7ssp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/_76sdp"
            android:layout_height="@dimen/_70sdp"
            android:background="@drawable/support_rectangle_white_box"
            android:gravity="center_horizontal"
            android:layout_marginStart="@dimen/_26sdp"
            android:orientation="vertical"
            android:padding="@dimen/_2sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:src="@drawable/ic_baseline_phone_iphone_24" />

            <TextView
                android:id="@+id/support_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:textColor="@color/app_blue_light"
                android:textSize="@dimen/_7ssp" />

            <TextView
                android:id="@+id/support_mobile2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/helvetica_neue_medium"
                android:text="@string/account"
                android:textAlignment="center"
                android:textColor="@color/app_blue_light"
                android:textSize="@dimen/_7ssp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/support_progr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

</LinearLayout>