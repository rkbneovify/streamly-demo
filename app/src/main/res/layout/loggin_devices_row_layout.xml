<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/white_border_background"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/_10sdp">


        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="0dp"
            android:src="@drawable/ic_register_devices"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/helvetica_neue_medium"
            android:maxLines="2"
            android:paddingVertical="@dimen/_4sdp"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toTopOf="@id/tvDeviceType"
            app:layout_constraintEnd_toStartOf="@id/logout"
            app:layout_constraintStart_toEndOf="@id/ivImage"
            app:layout_constraintTop_toTopOf="@id/ivImage"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@string/hotel_account_select_room" />


        <TextView
            android:id="@+id/tvDeviceType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/helvetica_neue_medium"
            android:maxLines="2"
            android:paddingVertical="@dimen/_4sdp"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@id/ivImage"
            app:layout_constraintEnd_toEndOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            tools:text="@string/hotel_account_select_room" />


        <CheckBox
            android:id="@+id/logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/color_white"
            android:fontFamily="@font/helvetica_neue_medium"
            android:textColor="@drawable/text_states"
            android:textSize="@dimen/_7ssp"
            android:theme="@style/MyCheckbox"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivImage"
            tools:checked="true" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>