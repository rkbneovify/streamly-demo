<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_310sdp"
    android:layout_height="@dimen/_170sdp"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:paddingLeft="@dimen/_10sdp"
    android:paddingRight="@dimen/_10sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_4sdp"
    android:background="@drawable/white_transparent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_6sdp">


        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/username_profile"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_8ssp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_5sdp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="@dimen/_100sdp"
            android:layout_height="wrap_content"
            android:text="Lou1234"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_7ssp"
            android:layout_marginTop="@dimen/_5sdp"/>

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="1dp"
                android:background="@color/md_white_1000"
                android:layout_marginTop="@dimen/_1sdp"/>

        </LinearLayout>


    </LinearLayout>


<!--    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_6sdp">


        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/password_profile"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_8ssp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_5sdp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="wrap_content"
                android:text="Change Password"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="@dimen/_5sdp"
                android:drawableRight="@drawable/ic_right_arrow"/>

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="1dp"
                android:background="@color/md_white_1000"
                android:layout_marginTop="@dimen/_1sdp"/>

        </LinearLayout>


    </LinearLayout>

<!--    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_6sdp">


        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_8ssp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_5sdp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="wrap_content"
                android:text="1.01"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="@dimen/_5sdp"/>

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="1dp"
                android:background="@color/md_white_1000"
                android:layout_marginTop="@dimen/_1sdp"/>

        </LinearLayout>


    </LinearLayout>

<!--    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_6sdp">


        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/build_date"
            android:textColor="@color/md_white_1000"
            android:textSize="@dimen/_8ssp"
            android:layout_marginTop="@dimen/_5sdp"
            android:textAlignment="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="wrap_content"
                android:text="14/04/2020"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/_7ssp"
                android:layout_marginTop="@dimen/_5sdp"/>

            <TextView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="1dp"
                android:background="@color/md_white_1000"
                android:layout_marginTop="@dimen/_1sdp"/>

        </LinearLayout>


    </LinearLayout>


    <Button
        android:id="@+id/btn_ok"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/signin_background"
        android:text="@string/ok"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:textAllCaps="false"
        android:textColor="@color/color_white"
        android:textSize="@dimen/_7ssp"
        android:layout_marginTop="@dimen/_14sdp"
        android:padding="@dimen/_2sdp" />


</LinearLayout>