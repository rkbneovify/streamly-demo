<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"
        android:drawable="@drawable/icons8_circled_right_64" /> <!-- pressed -->

    <item android:state_focused="true"
        android:drawable="@drawable/icons8_right_arrow_64">
        <shape android:shape="rectangle">
            <corners android:radius="20pt" />
            <solid android:color="@color/md_black_1000" />
        </shape>
    </item><!-- focused -->


    <!--    <item android:state_hovered="true" android:drawable="@drawable/white_transparent" /> &lt;!&ndash; hovered &ndash;&gt;-->
    <item android:drawable="@drawable/icons8_circled_right_64" /> <!-- default -->
</selector>