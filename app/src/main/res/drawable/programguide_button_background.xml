<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"
        android:drawable="@color/programguide_button_default" /> <!-- pressed -->

    <item android:state_focused="true">
    <shape android:shape="rectangle">
    <gradient
        android:startColor="@color/programguide_live_button"
        android:endColor="@color/programguide_live_button"
        />
    <corners android:radius="6dp" />
    </shape>
    </item>
    <!--    <item android:state_hovered="true" android:drawable="@drawable/white_transparent" /> &lt;!&ndash; hovered &ndash;&gt;-->
    <item android:drawable="@drawable/option_foucs" /> <!-- default -->
</selector>

