<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><!-- pressed -->
        <shape android:shape="rectangle">
            <solid android:color="@color/md_black_1000" />
        </shape>
    </item>


    <item android:state_focused="true"><!-- focused -->
        <shape android:shape="rectangle">
            <solid android:color="@color/md_blue_grey_800" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_grey_700" />
        </shape>
    </item>
</selector>