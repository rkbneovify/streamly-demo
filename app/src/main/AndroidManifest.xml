<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.streamly.TVApp.streamly">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" /> <!-- Used for loading the channel images with Glide -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/resized"
        android:icon="@drawable/app_icon_tv"
        android:label="@string/app_name"
        android:logo="@drawable/app_icon_tv"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="GoogleAppIndexingWarning"
        tools:replace="android:allowBackup">
        <activity android:name=".HotelQRCode.HotelQRCodeActivity"></activity>
        <activity android:name=".QRCode.QRCodeActivity" />
        <activity android:name=".search_channels.SearchActivity" />
        <activity android:name=".playervideo.PlayerActivity" />
