<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.adaptivemedia.streamlytv">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" /> <!-- Used for loading the channel images with Glide -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/resized"
        android:icon="@drawable/app_icon_tv"
        android:label="@string/app_name"
        android:logo="@drawable/app_icon_tv"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="GoogleAppIndexingWarning"
        tools:replace="android:allowBackup">
        <activity android:name="com.adaptivemedia.streamlytv.streamly.log_in.PersonalDeviceName" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.user_room.UserRoomActivity" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.loginusingpasscode.LoginUsingPasscodeActivity" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.HotelQRCode.HotelQRCodeActivity" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.QRCode.QRCodeActivity" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.search_channels.SearchActivity" />
        <activity android:name="com.adaptivemedia.streamlytv.streamly.playervideo.PlayerActivity" />
        <!--
        <activity
            android:name=".MainActivity"
            android:banner="@mipmap/streamly_logo"
            android:icon="@mipmap/streamly_logo"
            android:label="@string/app_name"
            android:logo="@drawable/tv_app_icon"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        -->
        <activity android:name="com.adaptivemedia.streamlytv.streamly.settings.SettingsActivity" /> <!-- <activity android:name=".channel_page.ChannelActivity" > -->
        <!--  -->
        <!-- </activity> -->
        <activity android:name="com.adaptivemedia.streamlytv.streamly.log_in.LogInActivity" />
        <activity
            android:name="com.adaptivemedia.streamlytv.streamly.splash.SplashActivity"
            android:banner="@drawable/resized"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.adaptivemedia.streamlytv.streamly.MainActivity" />
    </application>

</manifest>