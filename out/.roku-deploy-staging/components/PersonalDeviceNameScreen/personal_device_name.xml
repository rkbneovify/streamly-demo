<?xml version="1.0" encoding="UTF-8"?>
<component name="personal_device_name" extends="Group" initialFocus = "UsernamEditText"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">

    <script type="text/brightscript" uri="pkg:/components/PersonalDeviceNameScreen/personal_device_name.brs" />
    <script type = "text/brightscript" uri = "pkg:/source/utility.brs" />
    <script type = "text/brightscript" uri = "pkg:/components/ScreenStack.brs" />


    <interface>
        <field id="ExitView" type="boolean" alwaysNotify="true"/>
        <field id="showLoginView" type="boolean" alwaysNotify="true" />
        <field id="dialog" type="node" alwaysNotify="true"/>

        <field id="data" type="roAssociativeArray" />
        <field id="response" type="roAssociativeArray" />
        <field id="callto" type="String" />
        <field id="callType" type="String" />
        <field id="parameters" type="roAssociativeArray" />
        <field id="errorMessage" type="roAssociativeArray" />
    </interface>

    <children>
        <Poster id="personal_device_name_background_img" height="1080" width="1920" loadwidth="1280" loadheight="720" uri="pkg:/images/personal_device_name/blur_background.png" loadDisplayMode = "scaleTofill" />

        <Group>



            <Button id="logout" height="90" width="200" maxwidth="200" minwidth="200" iconuri="" focusedIconUri=""
            
            focusBitmapUri = "pkg:/images/home/borderwhite2.9.png" showFocusFootprint="true" translation= "[1550, 100]">
                <Label horizAlign="center" height = "82" Width  = "200" vertAlign = "center" text="Logout" size="40">
                    <Font role = "font" uri = "pkg:/fonts/Helvetica-Neue-Bold_22498.ttf" size = "40" />
                </Label>
            </Button>




            <!-- </LayoutGroup> -->

            <LayoutGroup 
                color = "0x00000033"
	      		id = "main_layout_group"
	      		itemSpacings = "[10]"
	      		layoutDirection = "horizontal">


                <LayoutGroup id="personal_device_text_rect"
                    itemSpacings = "[30]"
	      		    layoutDirection = "vert">

                    <Label text='Choose a name for your streamly &#xA;device' size="10" height="200" width="7000" color="#ffffff" wrap="true" id="simple_lable_1" translatio="[10,0]">
                        <Font role = "font" uri = "pkg:/fonts/Helvetica-Neue-Bold_22498.ttf" size = "60" />
                    </Label>
                    <Label text='A name will help identify your device when &#xA;accessing it from other device like your phone, &#xA;tablet or computer.' height="300" width="1000" color="#ffffff" wrap="true" id = "simple_lable_2" translatio="[10,0]">
                        <Font role = "font" uri = "pkg:/fonts/Helvetica-Neue-Light_22503.ttf" size = "40" />
                    </Label>
                    <Button width = "400" maxwidth="400" minwidth="400"  height = "50" id="personal_device_name_button_next" iconuri="" focusedIconUri="" focusBitmapUri = "pkg:/images/home/borderwhite2.9.png" showFocusFootprint="true">
                        <Label horizAlign="center" vertAlign= "center" text="Next" id="simple_next_text" width="400" height="90">
                            <Font role = "font" uri = "pkg:/fonts/Helvetica-Neue-Bold_22498.ttf" size = "40" />
                        </Label>
                    </Button>

                    <!-- <Button id="personal_device_name_button_next" height="90" width="200" maxwidth="200" minwidth="200" iconuri="" focusedIconUri=""
            
                            focusBitmapUri = "pkg:/images/home/categiryNavFocusIcon.png" showFocusFootprint="true" translation= "[1550, 100]">
                        <Label horizAlign="center" height = "50" Width  = "200" vertAlign = "center" text="Next" size="40" id="simple_next_text">
                            <Font role = "font" uri = "pkg:/fonts/Helvetica-Neue-Bold_22498.ttf" size = "40" />
                        </Label>
                    </Button> -->
                </LayoutGroup>

                <LayoutGroup itemSpacings = "[0]" layoutDirection = "vert" id="personal_device_edit_text_rect">
                    <LayoutGroup
                        itemSpacings = "[0]"
                        layoutDirection = "vert" translation= "[0, 0]">
                        <TextEditBox
                            id = "device_name_edit_text" hintTextColor="0xffffff50"                 
                            width = "0" textColor="0xffffff" backgroundUri="pkg:/images/edittext_transparent.png" clearOnDownKey="false" hintText="Enter device name" />
                        <Rectangle color = "0xffffff" id="personal_device_edit_text_bottom_line" />
                    </LayoutGroup>
                </LayoutGroup>
            </LayoutGroup>
        </Group>
        <Poster id = "KeyboardPoster" translation= "[0,670]" height="779" width="1920" uri="pkg:/images/LoginBackgroundpng.png" visible="false">
            <Keyboard id = "KeyboardInput" translation= "[250,0]" showTextEditBox="false" />
        </Poster>
        <Poster
         id = "logoutView" visible="false"
         width  = "1223"
         height = "724" uri="pkg:/images/profile/profile_dialog.png"    
         loadDisplayMode = "scaleToFill">

            <Label
         
             id = "logoutText" 
             text = ""
             width  = "1223" horizAlign="center" vertAlign="center"
             height = "36" 
             translation = "[0,117]"/>

            <Button id="NoButton" visible="true" translation= "[275,287]"
                 minWidth  = "275"
                 maxWidth  = "275" focusedTextColor="#FFFFFF"
                 height = "84"
                 focusFootprintBitmapUri = "pkg:/images/home/borderwhite3.png" focusBitmapUri="pkg:/images/Login/buttonFoucs.png"
                 BitmapUri =               "pkg:/images/profile/button1focus.png" showFocusFootprint="true" iconUri="" focusedIconUri="" horizAlign="center">

                <Label id="labelNo" horizAlign="center"
                        height = "84"
                        Width  = "275"
                        vertAlign = "center" text="No" />
            </Button>
            <Button id="YesButton" visible="true" translation= "[669,287]"
                minWidth  = "275"
                maxWidth  = "275" focusedTextColor="#FFFFFF"
                height = "84"
                focusFootprintBitmapUri = "pkg:/images/home/borderwhite3.png" focusBitmapUri="pkg:/images/Login/buttonFoucs.png"
                BitmapUri =               "pkg:/images/profile/button1focus.png" iconUri="" focusedIconUri="" showFocusFootprint="true" horizAlign="center">
                <Label id="labelYes" horizAlign="center"
                        height = "84"
                        Width  = "275"
                        vertAlign = "center" text="Yes" />
            </Button>


        </Poster>
        <Rectangle id="LoaderBackground" color="0x000000FF" visible="false" opacity="0.65" />
        <BusySpinner 
	 
	    		id = "LoginBusySpinner" 
		    	visible = "false" />
    </children>
</component>