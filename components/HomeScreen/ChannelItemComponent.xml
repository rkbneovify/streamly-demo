<?xml version="1.0" encoding="UTF-8"?>
<component name="ChannelItemComponent" extends="Group" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">
	
	<interface>
      <field id="content" type="node"  onChange = "showcontent" />
      <field id="width" type="float" />
      <field id="height" type="float" />
    </interface>
	
	<script type="text/brightscript" uri="pkg:/components/HomeScreen/ChannelItemComponent.brs" />
<script type = "text/brightscript" >
 <![CDATA[

 sub init()
    
      m.title = m.top.findNode("title")
      m.poster = m.top.findNode("poster")
    
    end sub

sub showcontent()

if m.top.content<>invalid
      m.title.font= "font:SmallSystemFont"
      m.title.font.size=22
      m.poster.uri=m.top.content.HDSMALLICONURL
      m.title.text = m.top.content.TITLE
end if 
     
end sub  

    ]]>
</script>
    <children>
       
       <Poster
           
           loadDisplayMode="scaleToFill"           
           translation="[0,0]"
           height="82"
           width="280"
           uri="pkg:/images/home/channelinfobackgrnd.png"
        /> 
        
          <Poster
            id="poster"
            loadDisplayMode="scaleToFit"
            translation="[60,20]"
            height = "50"
            width =  "70"
            loadHeight ="50"
            loadWidth ="70"
          />
           <Label
            id="title"
            height="50"
            width="200"                  
           
            translation="[150,35]"
            />            
    </children>
</component>

