<component name="ChannellistMarkuGridComponent" extends="Group">
  <script type="text/brightscript" uri="ChannellistMarkuGridComponent.brs" />
  <interface>
    <field id="itemContent" type="node"  onChange = "showcontent" />


    <field id = "width" type = "float" onChange = "setSize"/>
    <field id = "height" type = "float" onChange = "setSize"/>

    <field id = "itemHasFocus" type = "boolean" onChange = "setfocus"/>
    <field id = "focusPercent" type = "float" onChange = "setfocus"/>


  </interface>

  <script type="text/brightscript" uri="pkg:/components/SearchScreen/ChannellistMarkuGridComponent/ChannellistMarkuGridComponent.brs" />
