<?xml version="1.0" encoding="UTF-8"?>
<component name="ProfileItemComponent" extends="Group" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">

	<script type="text/brightscript" uri="pkg:/components/ProfileSettingScreen/ProfileItemComponent/ProfileItemComponent.brs" />
    <script type = "text/brightscript" uri = "pkg:/source/utility.brs" />
    
  <interface> 
   
     <field id = "itemContent" type = "node" onChange = "showcontent"/>
     <field id="width"       type="float" onChange="updateLayout"/>
     <field id="height"      type="float" onChange="updateLayout"/>
     <field id = "focusPercent" type = "float" onChange = "showfocus"/> 
     <field id = "itemHasFocus" type = "boolean" onChange = "setfcous"/> 
        
  </interface>
  
  <children >
     
      <Poster      
      
        id = "background" 
        translation = "[ 0, 0 ]"
        width  = "280"
        height = "268"
        opacity="1.0"
        uri="pkg:/images/profile/markupitemcomponentBackground.png"    
        loadDisplayMode = "scaleToFill"/>
        
      <Poster      
      
        id = "currentfocus" 
        translation = "[ 0, 0 ]"
        width  = "280"
        height = "268"
        opacity="0.0"
        uri="pkg:/images/profile/markupitemcomponentimage.png"    
        loadDisplayMode = "scaleToFill">
      </Poster>     
          
      <Poster      
      
        id = "icon" 
        translation = "[ 101, 51 ]"
        width  = "78"
        height = "90"        
        uri="pkg:/images/profile/profileicon.png"    
        loadDisplayMode = "scaleToFit"/>
        
        <Label id="textLabel" translation = "[ 86, 209 ]"/>
        
  </children>

</component>

